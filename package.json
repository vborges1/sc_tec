{
  "name": "sc-tec-api",
  "version": "1.0.0",
  "description": "Microserviço de gerenciamento de empreendimentos imobiliários com API CRUD usando Node.js, Express, TypeScript e SQLite",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch 'src/' --ext ts --exec 'ts-node' src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node ./dist/server.js",
    "lint": "eslint . --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "sqlite",
    "api",
    "crud"
  ],
  "author": "Vitor Borges",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "figlet": "^1.10.0",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.7.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
